{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "295879371888597807"
    },
    "poznamka": "ARM soubor infra/main.json je VYGENEROVANÝ z tohoto zdroje: az bicep build -f infra/main.bicep --outfile infra/main.json. main.json needitujte ručně – změny dělejte tady a přegenerujte, jinak se zdroj a artefakt tiše rozejdou. CDN kopie šablony pro tlačítko Deploy to Azure dostává při release vyplněný default packageUrl (viz scripts/build-release-zip.ps1)."
  },
  "parameters": {
    "functionAppName": {
      "type": "string",
      "metadata": {
        "description": "Název Function App (musí být globálně unikátní), např. func-contoso-ai"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region pro nasazení zdrojů"
      }
    },
    "azureOpenAiEndpoint": {
      "type": "string",
      "metadata": {
        "description": "URL Azure OpenAI resource, např. https://contoso-openai.openai.azure.com"
      }
    },
    "azureOpenAiKey": {
      "type": "securestring",
      "metadata": {
        "description": "API klíč Azure OpenAI resource"
      }
    },
    "azureOpenAiDeployment": {
      "type": "string",
      "defaultValue": "gpt-5-mini",
      "metadata": {
        "description": "Název deploymentu modelu v Azure OpenAI, např. gpt-5-mini. U reasoning modelů (gpt-5*, o-řada) musí jméno deploymentu začínat gpt-5/o, jinak funkce použije klasický API kontrakt (temperature) a model dotaz odmítne."
      }
    },
    "allowedOrigin": {
      "type": "string",
      "metadata": {
        "description": "Origin SharePoint tenantu pro CORS, např. https://contoso.sharepoint.com (víc originů oddělte čárkou). Funkce je fail-closed — bez této hodnoty prohlížeč volání chatu odmítne."
      }
    },
    "packageUrl": {
      "type": "string",
      "defaultValue": "https://cdn.easyportal365.cz/chat-function/ep365-chat-function-1.5.3.zip",
      "metadata": {
        "description": "VOLITELNÉ — URL release zip balíčku s kódem funkce. Vyplněné = WEBSITE_RUN_FROM_PACKAGE ukazuje na tento zip a kód se načte přímo z něj (cesta „Deploy to Azure“). Prázdné = WEBSITE_RUN_FROM_PACKAGE se nastaví na 1 a kód nasadíte zvlášť (deploy skript / zip deploy / func publish / GitHub Actions)."
      }
    },
    "aadTenantId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "VOLITELNÉ — Entra ID tenant ID pro Znalostní přípravu (Graph client credentials)"
      }
    },
    "aadClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "VOLITELNÉ — Application (client) ID app registrace s Graph application permission Sites.Selected"
      }
    },
    "aadClientSecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "VOLITELNÉ — client secret app registrace pro Znalostní přípravu"
      }
    },
    "settingsSiteUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "VOLITELNÉ — absolutní URL webu se settings listem EP365AIChatAppSettings, např. https://contoso.sharepoint.com/sites/ai"
      }
    }
  },
  "variables": {
    "storageAccountName": "[toLower(take(replace(parameters('functionAppName'), '-', ''), 24))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[format('{0}-insights', parameters('functionAppName'))]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "RetentionInDays": 30
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}-plan', parameters('functionAppName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Y1",
        "tier": "Dynamic"
      },
      "properties": {}
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[parameters('functionAppName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp",
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('functionAppName')))]",
        "siteConfig": {
          "nodeVersion": "~22",
          "appSettings": [
            {
              "name": "AzureWebJobsStorage",
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};AccountKey={1};EndpointSuffix=core.windows.net', variables('storageAccountName'), listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').keys[0].value)]"
            },
            {
              "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};AccountKey={1};EndpointSuffix=core.windows.net', variables('storageAccountName'), listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').keys[0].value)]"
            },
            {
              "name": "WEBSITE_CONTENTSHARE",
              "value": "[parameters('functionAppName')]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "node"
            },
            {
              "name": "WEBSITE_NODE_DEFAULT_VERSION",
              "value": "~22"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference(resourceId('Microsoft.Insights/components', format('{0}-insights', parameters('functionAppName'))), '2020-02-02').InstrumentationKey]"
            },
            {
              "name": "AZURE_OPENAI_ENDPOINT",
              "value": "[parameters('azureOpenAiEndpoint')]"
            },
            {
              "name": "AZURE_OPENAI_KEY",
              "value": "[parameters('azureOpenAiKey')]"
            },
            {
              "name": "AZURE_OPENAI_DEPLOYMENT",
              "value": "[parameters('azureOpenAiDeployment')]"
            },
            {
              "name": "ALLOWED_ORIGIN",
              "value": "[parameters('allowedOrigin')]"
            },
            {
              "name": "AAD_TENANT_ID",
              "value": "[parameters('aadTenantId')]"
            },
            {
              "name": "AAD_CLIENT_ID",
              "value": "[parameters('aadClientId')]"
            },
            {
              "name": "AAD_CLIENT_SECRET",
              "value": "[parameters('aadClientSecret')]"
            },
            {
              "name": "EP365_SETTINGS_SITE_URL",
              "value": "[parameters('settingsSiteUrl')]"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "[if(empty(parameters('packageUrl')), '1', parameters('packageUrl'))]"
            }
          ]
        },
        "httpsOnly": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', format('{0}-insights', parameters('functionAppName')))]",
        "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('functionAppName')))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    }
  ],
  "outputs": {
    "functionAppUrl": {
      "type": "string",
      "value": "[format('https://{0}/api', reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2023-01-01').defaultHostName)]"
    },
    "functionAppName": {
      "type": "string",
      "value": "[parameters('functionAppName')]"
    }
  }
}